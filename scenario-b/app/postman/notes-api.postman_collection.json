    {
      "name": "Stats",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('the answer is about the calling tenant', function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.data.tenant_slug).to.eql(pm.collectionVariables.get('tenant'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/stats",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "stats"
          ]
        },
        "description": "Counts for the calling tenant. The query joins all three tables: tenants, notes, tags.\n\nIt returns only the calling tenant, not all five. Showing other tenants' counts would break tenant isolation.\n\nChange the `tenant` variable to see another tenant:\n\n| tenant | notes | tags |\n|---|---|---|\n| acme | 30,000 | about 89,500 |\n| globex | 8,000 | about 24,200 |\n| initech | 6,000 | about 18,200 |\n| umbrella | 4,000 | about 12,200 |\n| hooli | 2,000 | about 5,900 |"
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant",
                "value": "acme"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stats"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"data\": {\n        \"tenant_id\": 1,\n        \"tenant_slug\": \"acme\",\n        \"notes_count\": 30001,\n        \"tags_count\": 89511\n    }\n}"
        }
      ]
    },
