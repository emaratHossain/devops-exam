              "value": "application/json"
            }
          ],
          "body": "{\n    \"message\": \"Note not found.\"\n}"
        }
      ]
    },
    {
      "name": "Search note bodies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('every hit really contains the word', function () {",
              "    var body = pm.response.json();",
              "    var word = body.meta.q.toLowerCase();",
              "    body.data.forEach(function (n) {",
              "        pm.expect(n.body.toLowerCase()).to.include(word);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/search?q=rocket&page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "rocket",
              "description": "The word to look for inside the note body. Required."
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Looks for a word inside the note body, for this tenant only.\n\nThe query is `body ILIKE '%word%'`. No index can help that, so it reads the whole table. On 30,000 notes it is slow. That is on purpose.\n\nWords you can try: rocket, harbor, winter, zebra, quartz."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant",
                "value": "acme"
              }
            ],
            "url": {
              "raw": "{{base_url}}/search?q=rocket&limit=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "rocket"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"data\": [\n        {\n            \"id\": 50001,\n            \"tenant_id\": 1,\n            \"title\": \"Exam note\",\n            \"body\": \"this body mentions rocket and harbor\",\n            \"created_at\": \"2026-09-02 00:08:01\"\n        }\n    ],\n    \"meta\": {\n        \"page\": 1,\n        \"limit\": 1,\n        \"total\": 4771,\n        \"pages\": 4771,\n        \"q\": \"rocket\"\n    }\n}"
        },
        {
          "name": "422 Missing q",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant",
                "value": "acme"
              }
            ],
            "url": {
              "raw": "{{base_url}}/search",
