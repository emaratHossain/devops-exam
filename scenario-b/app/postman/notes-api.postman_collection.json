{
  "info": {
    "name": "Scenario B - Multi-tenant Notes API",
    "description": "Laravel + PostgreSQL Notes API.\n\nEvery request needs the header `X-Tenant`. It holds the tenant slug, for example `acme`.\nThe server finds the tenant by that slug and adds `where tenant_id = ?` to every query.\n\nSeeded tenants: acme (30,000 notes), globex (8,000), initech (6,000), umbrella (4,000), hooli (2,000).\n\nChange the tenant for the whole collection in the Variables tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string",
      "description": "Where the API runs. Change this if you use another port."
    },
    {
      "key": "tenant",
      "value": "acme",
      "type": "string",
      "description": "The tenant slug sent in the X-Tenant header."
    },
    {
      "key": "other_tenant",
      "value": "hooli",
      "type": "string",
      "description": "A second tenant, used to prove one tenant cannot read another tenant's note."
    },
    {
      "key": "note_id",
      "value": "1",
      "type": "string",
      "description": "Set by the 'Create a note' request automatically."
    }
  ],
  "item": [
    {
      "name": "Create a note",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Save the new id so the other requests can use it.",
              "var body = pm.response.json();",
              "pm.collectionVariables.set('note_id', body.data.id);",
              "",
              "pm.test('the note belongs to the calling tenant', function () {",
              "    pm.expect(body.data.tenant_id).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Exam note\",\n  \"body\": \"this body mentions rocket and harbor\",\n  \"tags\": [\"work\", \"urgent\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notes"
          ]
        },
        "description": "Makes one note for the tenant in the X-Tenant header.\n\nFields:\n- `title` - required, text, max 255\n- `body` - required, text\n- `tags` - optional, list of text, max 20 items\n\nReturns 201 and the new note. Returns 422 if a field is wrong."
      },
      "response": [
        {
          "name": "201 Created",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant",
                "value": "acme"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Exam note\",\n  \"body\": \"this body mentions rocket and harbor\",\n  \"tags\": [\"work\", \"urgent\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/notes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "notes"
              ]
            }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"data\": {\n        \"id\": 50001,\n        \"tenant_id\": 1,\n        \"title\": \"Exam note\",\n        \"body\": \"this body mentions rocket and harbor\",\n        \"created_at\": \"2026-09-02T00:08:01.000000Z\",\n        \"tags\": [\n            \"work\",\n            \"urgent\"\n        ]\n    }\n}"
        },
        {
          "name": "422 Missing title",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant",
                "value": "acme"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"no title here\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/notes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "notes"
              ]
            }
          },
          "status": "Unprocessable Content",
          "code": 422,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"message\": \"The title field is required.\",\n    \"errors\": {\n        \"title\": [\n            \"The title field is required.\"\n        ]\n    }\n}"
        }
      ]
    },
    {
      "name": "List notes (paginated)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('every note belongs to one tenant only', function () {",
              "    var body = pm.response.json();",
              "    var ids = body.data.map(function (n) { return n.tenant_id; });",
              "    var unique = ids.filter(function (v, i, a) { return a.indexOf(v) === i; });",
              "    pm.expect(unique.length).to.be.below(2);",
              "});",
              "",
              "pm.test('every note carries its tags', function () {",
              "    pm.response.json().data.forEach(function (n) {",
              "        pm.expect(n.tags).to.be.an('array');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/notes?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notes"
          ],
          "query": [
            {
              "key": "page",
              "value": "1",
              "description": "Page number. Starts at 1."
            },
            {
              "key": "limit",
              "value": "20",
              "description": "Rows per page. Highest allowed is 100."
            }
          ]
        },
        "description": "Lists the notes of the calling tenant, newest first. Each note also carries its tags.\n\n`meta.total` is the number of notes this tenant has. For tenant `acme` that is about 30,000."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant",
                "value": "acme"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notes?page=1&limit=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "notes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"data\": [\n        {\n            \"id\": 50001,\n            \"tenant_id\": 1,\n            \"title\": \"Exam note\",\n            \"body\": \"this body mentions rocket and harbor\",\n            \"created_at\": \"2026-09-02 00:08:01\",\n            \"tags\": [\n                \"work\",\n                \"urgent\"\n            ]\n        },\n        {\n            \"id\": 30000,\n            \"tenant_id\": 1,\n            \"title\": \"Ocean sandal lantern\",\n            \"body\": \"cellar letter vision eagle corner system salmon diesel zebra copper marble ground crystal watch dinner yellow tower ground coffee valley email tissue gather printer pepper nectar vision needle driver diesel watch meteor earth steady eagle corner system violet fabric market dagger travel wheel rubber tomato.\",\n            \"created_at\": \"2025-10-11 03:21:17\",\n            \"tags\": [\n                \"todo\",\n                \"review\",\n                \"work\"\n            ]\n        }\n    ],\n    \"meta\": {\n        \"page\": 1,\n        \"limit\": 2,\n        \"total\": 30001,\n        \"pages\": 15001\n    }\n}"
        }
      ]
    },
    {
      "name": "Get one note",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('the note has a tags list', function () {",
              "    pm.expect(pm.response.json().data.tags).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/notes/{{note_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notes",
            "{{note_id}}"
          ]
        },
        "description": "Reads one note and its tags.\n\n`note_id` is set for you when you run 'Create a note'.\n\nIf the note belongs to another tenant, the answer is 404. It looks like the note does not exist."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant",
                "value": "acme"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notes/50001",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "notes",
                "50001"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n    \"data\": {\n        \"id\": 50001,\n        \"tenant_id\": 1,\n        \"title\": \"Exam note\",\n        \"body\": \"this body mentions rocket and harbor\",\n        \"created_at\": \"2026-09-02 00:08:01\",\n        \"tags\": [\n            \"work\",\n            \"urgent\"\n        ]\n    }\n}"
        },
        {
          "name": "404 Not found",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant",
                "value": "acme"
              }
